{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/JINX-DEFINITIVE.apk",
      "destination": "https://github.com/d34903295-ux/Jinx.app/releases/download/v1.0.0/JINX-DEFINITIVE.apk",
      "permanent": false
    },
    {
      "source": "/Jinx-app.apk",
      "destination": "https://github.com/d34903295-ux/Jinx.app/releases/download/v1.0.0/JINX-DEFINITIVE.apk",
      "permanent": false
    },
    {
      "source": "/Jinx.apk",
      "destination": "https://github.com/d34903295-ux/Jinx.app/releases/download/v1.0.0/JINX-DEFINITIVE.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"JINX DEFINITIVE.apk\""
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
